---
import Base from "../layouts/Base.astro";
import skills from "../data/skills.json";
import metaRaw from "../data/skills_meta.json";

const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const meta = Object.fromEntries(metaRaw.skills.map((s) => [s.id, s]));
const catNames = { lang: "语言与通用", "ml-core": "机器学习核心", "llm-framework": "LLM 应用框架", rag: "RAG 与检索", agent: "Agent 与工具调用", serving: "推理服务与性能", training: "训练与微调", cloud: "云与 DevOps", data: "数据工程", eval: "评估与质量", security: "安全与合规", multimodal: "多模态", product: "产品与业务", frontend: "前端与原型" };
const byCat = {};
for (const s of skills.skills) {
  const c = meta[s.id]?.category ?? "other";
  (byCat[c] ??= []).push(s);
}
const catOrder = Object.keys(catNames).filter((c) => byCat[c]?.length);
const pairs = skills.cooccurrence_top.slice(0, 15);
const zh = (id: string) => meta[id]?.name_zh ?? id;
const noise = skills.noise_candidates.filter((n) => n.verdict.includes("噪音"));
---
<Base>
  <section class="pt-12 pb-2 md:pt-16">
    <h1 class="text-[32px] md:text-[44px] font-extrabold leading-tight tracking-tight">技能图谱</h1>
    <p class="muted mt-4 max-w-[70ch] text-[14.5px] leading-relaxed">
      共 {skills.skills.length} 项技能在 {skills.total_ai_jobs.toLocaleString()} 条 AI 岗位帖中被正则字典命中。
      溢价 = 含该技能岗位的薪资中位数差（同池对比），n 为薪资样本数；样本不足显式标注，不做推断。
    </p>
  </section>

  <section class="sec grid md:grid-cols-2 gap-x-12 gap-y-10">
    <div>
      <h2>技能共现 Top 15</h2>
      <p class="note">同时出现在同一岗位帖中的技能对。</p>
      <div id="chart-pairs" class="h-96"></div>
    </div>
    <div>
      <h2>噪音技能候选</h2>
      <p class="note">高提及 × 溢价近零 × 岗位区分度低。指「不构成差异化」，不等于不需要。</p>
      {noise.length ? noise.map((n) => (
        <div class="py-2 border-b border-[var(--line)] text-[13.5px]">
          <div class="flex justify-between"><span>{zh(n.skill)}</span><span class="num muted">出现 {n.freq_pct}% · 溢价 {n.delta_pct}%</span></div>
          <div class="muted text-[12px] mt-0.5">{n.verdict}</div>
        </div>
      )) : <p class="muted text-[13px]">本期语料中未发现同时满足三个噪音条件的技能（详见研究报告的宽松口径列表）。</p>}
      <h3 class="font-bold text-[14px] mt-8 mb-2">无法判定溢价的常见技能</h3>
      <p class="muted text-[12.5px] mb-2">薪资样本不足，只给出现率不给溢价结论。</p>
      <p class="text-[13px] leading-loose">
        {skills.skills.filter((s) => s.confidence === "insufficient" && s.count >= 10).slice(0, 14).map((s) => s.name_zh).join("，")}
      </p>
    </div>
  </section>

  {catOrder.map((c) => (
    <section class="sec">
      <h2>{catNames[c]} <span class="muted text-[12.5px] font-normal">（{byCat[c].length} 项）</span></h2>
      <div class="overflow-x-auto">
        <table class="data">
          <thead><tr><th>技能</th><th>英文</th><th class="num">出现率</th><th class="num">中文出现率</th><th class="num">帖数</th><th class="num">溢价</th><th class="num">薪资样本</th><th>置信度</th></tr></thead>
          <tbody>
            {byCat[c].map((s) => (
              <tr>
                <td class="font-medium">{s.name_zh}</td>
                <td class="muted">{s.name_en}</td>
                <td class="num">{s.freq_pct}%</td>
                <td class="num">{s.count_zh > 0 ? `${s.freq_zh_pct}%` : <span class="missing">无样本</span>}</td>
                <td class="num">{s.count}</td>
                <td class="num">
                  {s.delta_pct != null
                    ? <span class={s.delta_pct > 5 ? "up" : s.delta_pct < -5 ? "down" : ""}>{s.delta_pct > 0 ? "+" : ""}{s.delta_pct}%</span>
                    : <span class="missing">样本不足</span>}
                </td>
                <td class="num">{s.n_with || "无"}</td>
                <td class="muted">{s.confidence === "insufficient" ? "无" : { low: "低", medium: "中", high: "高" }[s.confidence]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="sec">
    <h2>共现明细</h2>
    <p class="text-[13px] leading-loose">
      {pairs.map((p2) => `${zh(p2.a)} 与 ${zh(p2.b)}（${p2.n}）`).join("，")}
    </p>
  </section>
</Base>

<script src={B + "echarts.min.js"} defer></script>
<script define:vars={{ pairs }}>
  window.addEventListener("DOMContentLoaded", () => {
    const namesEl = document.getElementById("pair-names");
    const names = namesEl ? JSON.parse(namesEl.textContent) : {};
    if (!window.echarts) return;
    const css = getComputedStyle(document.documentElement);
    const C = {
      ink: css.getPropertyValue("--ink").trim() || "#211f1c",
      muted: css.getPropertyValue("--muted").trim() || "#716e66",
      accent: css.getPropertyValue("--accent").trim() || "#b03a26",
    };
    const el = document.getElementById("chart-pairs");
    const c = echarts.init(el);
    const labels = pairs.map((p) => names[p.a] + " 与 " + names[p.b]).reverse();
    c.setOption({
      textStyle: { color: C.muted },
      grid: { left: 8, right: 44, top: 4, bottom: 4, containLabel: true },
      xAxis: { type: "value", splitLine: { show: false }, axisLabel: { color: C.muted, fontSize: 10 } },
      yAxis: { type: "category", data: labels, axisLine: { show: false }, axisTick: { show: false }, axisLabel: { color: C.ink, fontSize: 10.5, width: 170, overflow: "truncate" } },
      tooltip: {},
      series: [{ type: "bar", data: pairs.map((p) => p.n).reverse(), itemStyle: { color: C.ink }, barMaxWidth: 8,
        label: { show: true, position: "right", color: C.muted, fontSize: 10, fontFamily: "IBM Plex Mono, Menlo, monospace" } }],
    });
    window.addEventListener("resize", () => c.resize());
  });
</script>
<script type="application/json" id="pair-names" set:html={JSON.stringify(Object.fromEntries(skills.skills.map((s) => [s.id, s.name_zh])))} />
