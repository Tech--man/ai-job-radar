---
import Base from "../layouts/Base.astro";
import companies from "../data/companies.json";
import overview from "../data/overview.json";

const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const zh = (rid) => overview.role_distribution.find((x) => x.role === rid)?.name_zh ?? ({ "ml-research": "算法研究", other: "通用工程" })[rid] ?? rid;
const top = companies.companies.slice(0, 30);
---
<Base>
  <section class="pt-12 pb-4 md:pt-16">
    <h1 class="text-[32px] md:text-[44px] font-extrabold leading-tight tracking-tight">公司热度</h1>
    <p class="muted mt-4 max-w-[70ch] text-[14.5px] leading-relaxed">
      AI 岗位帖中出现三次以上的公司，按帖次数计（含跨月重复招聘：持续数月在招本身就是招聘强度信号）。
      公司名来自帖子自述的启发式抽取与归一，存在残余噪声。中文官方渠道（腾讯、百度为单公司全量 dump）不计入本榜，见<a class="accent" href={B + "zh-market"}>中文市场页</a>。
    </p>
  </section>

  <section class="sec grid md:grid-cols-5 gap-x-12 gap-y-10">
    <div class="md:col-span-2">
      <h2>Top 30</h2>
      <div id="chart-companies" class="h-[560px]"></div>
    </div>
    <div class="md:col-span-3">
      <h2>明细（含主要招聘方向）</h2>
      <div class="overflow-x-auto">
        <table class="data">
          <thead><tr><th class="num">#</th><th>公司</th><th class="num">帖次数</th><th>主要招聘方向</th></tr></thead>
          <tbody>
            {companies.companies.map((c, i) => (
              <tr>
                <td class="num muted">{i + 1}</td>
                <td class="font-medium">{c.company}{c.is_bigtech_listed && <span class="muted text-[11px] ml-2">大厂名单</span>}</td>
                <td class="num">{c.n}</td>
                <td class="muted">{c.top_roles.map(([r, n]) => `${zh(r)} ${n}`).join("，")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<script src={B + "echarts.min.js"} defer></script>
<script define:vars={{ top }}>
  window.addEventListener("DOMContentLoaded", () => {
    if (!window.echarts) return;
    const css = getComputedStyle(document.documentElement);
    const C = {
      ink: css.getPropertyValue("--ink").trim() || "#211f1c",
      muted: css.getPropertyValue("--muted").trim() || "#716e66",
      accent: css.getPropertyValue("--accent").trim() || "#b03a26",
    };
    const c = echarts.init(document.getElementById("chart-companies"));
    c.setOption({
      textStyle: { color: C.muted },
      grid: { left: 8, right: 40, top: 4, bottom: 4, containLabel: true },
      xAxis: { type: "value", splitLine: { show: false }, axisLabel: { color: C.muted, fontSize: 10 } },
      yAxis: { type: "category", data: top.map((x) => x.company).reverse(), axisLine: { show: false }, axisTick: { show: false }, axisLabel: { color: C.ink, fontSize: 11 } },
      tooltip: {},
      series: [{ type: "bar", data: top.map((x) => x.n).reverse(), itemStyle: { color: C.accent }, barMaxWidth: 9,
        label: { show: true, position: "right", color: C.muted, fontSize: 10, fontFamily: "IBM Plex Mono, Menlo, monospace" } }],
    });
    window.addEventListener("resize", () => c.resize());
  });
</script>
