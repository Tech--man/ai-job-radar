---
import Base from "../layouts/Base.astro";
import overview from "../data/overview.json";
import trend from "../data/trend.json";
import salary from "../data/salary.json";
import skills from "../data/skills.json";

const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const src = overview.built_from;
const zh = overview.zh;
const months = src.months;
const kpis = [
  { v: src.ai_posts.toLocaleString("en-US"), l: "AI 相关岗位帖（全球）" },
  { v: zh.ai_posts.toLocaleString("en-US"), l: "其中中文市场" },
  { v: src.salary_posts.toLocaleString("en-US"), l: "含真实薪资区间" },
  { v: skills.skills.length.toString(), l: "技能字典命中项" },
];

function k(v: number) { return "$" + Math.round(v / 1000) + "k"; }
const roleData = overview.role_distribution.filter((r) => r.n > 0 && r.n < 500);
const withDelta = skills.skills.filter((s) => s.delta_pct != null);
const up = [...withDelta].sort((a, b) => b.delta_pct - a.delta_pct).slice(0, 5);
const down = [...withDelta].sort((a, b) => a.delta_pct - b.delta_pct).slice(0, 4);
const roleSal = Object.entries(salary.by_role)
  .filter(([rid, r]) => r.median_mid && !["rag", "ai-security", "ml-research"].includes(rid))
  .sort((a, b) => b[1].median_mid - a[1].median_mid).slice(0, 6);
const roleZh = { "llm-app": "LLM 应用", "agent": "Agent", "rag": "RAG", "mlops": "Infra", "ai-pm": "AI 产品", "data-eng": "数据工程", "ai-solutions": "解决方案", "ai-growth": "销售增长", "ml-research": "算法研究", "ai-security": "AI 安全", "other": "通用工程" };
---
<Base>
  <!-- Hero：左对齐，标题两行内，副文一句，无装饰 -->
  <section class="pt-14 pb-10 md:pt-20">
    <h1 class="text-[34px] md:text-[52px] font-extrabold leading-[1.08] tracking-tight max-w-[21ch]">
      AI 岗位行情，<br />用公开数据说话
    </h1>
    <p class="muted mt-5 max-w-[62ch] text-[15px] leading-relaxed">
      6,176 条岗位帖的结构化分析：招什么技能、哪些溢价是真的、谁在招人、转型怎么走。
      数据来自 HN、腾讯与百度招聘官网、BOSS直聘授权切片等公开渠道，全链路可复现。
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a class="btn" href={B + "radar"}>生成我的转型路线</a>
      <a class="btn btn-ghost" href={B + "report"}>读研究报告</a>
    </div>
  </section>

  <!-- 统计条：无卡片，等宽数字 -->
  <section class="rule-strong pt-5 pb-12 grid grid-cols-2 md:grid-cols-4 gap-y-6 gap-x-4">
    {kpis.map((s) => (
      <div class="stat"><div class="v">{s.v}</div><div class="l">{s.l}</div></div>
    ))}
  </section>

  <!-- 溢价结论：先给答案 -->
  <section class="sec">
    <h2>技能溢价：真钱在哪</h2>
    <p class="note">溢价 = 含该技能岗位的薪资中位数差（同池对比）。红为正溢价，绿为负；n 是薪资样本数，样本不足的一律不给你编数字。</p>
    <div class="grid md:grid-cols-2 gap-x-12">
      <div>
        <table class="data">
          <thead><tr><th>技能（溢价前五）</th><th class="num">溢价</th><th class="num">n</th></tr></thead>
          <tbody>
            {up.map((s) => (
              <tr>
                <td class="font-medium">{s.name_zh}</td>
                <td class="num up">+{s.delta_pct}%</td>
                <td class="num muted">{s.n_with}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 md:mt-0">
        <table class="data">
          <thead><tr><th>技能（溢价垫底）</th><th class="num">溢价</th><th class="num">n</th></tr></thead>
          <tbody>
            {down.map((s) => (
              <tr>
                <td class="font-medium">{s.name_zh}</td>
                <td class="num down">{s.delta_pct}%</td>
                <td class="num muted">{s.n_with}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="muted text-[12.5px] mt-4">溢价是相关不是因果：高溢价技能的从业者也常在大厂与高成本城市。完整口径见<a class="accent" href={B + "about"}>方法页</a>。</p>
  </section>

  <!-- 岗位分布 + 月度趋势 -->
  <section class="sec grid md:grid-cols-5 gap-x-12 gap-y-10">
    <div class="md:col-span-2">
      <h2>岗位分布</h2>
      <p class="note">主分类口径；RAG 等组合型岗位以多标签口径记在画像页。</p>
      <div id="chart-roles" class="h-72"></div>
    </div>
    <div class="md:col-span-3">
      <h2>AI 招聘占比：一年抬升约 15 个百分点</h2>
      <p class="note">HN「Who is hiring?」月度帖，全量帖 vs AI 相关帖（2025-10 至 2026-10，13 期）。</p>
      <div id="chart-trend" class="h-72"></div>
    </div>
  </section>

  <!-- 薪资中位速览 -->
  <section class="sec">
    <h2>薪资中位速览（USD 年薪）</h2>
    <p class="note">区间中值口径，只列样本足够（n≥20）的岗位族。约四分之三的帖子不披露薪资，本站对缺失一律标注。</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
      {roleSal.map(([rid, r]) => (
        <div class="flex items-baseline justify-between border-b border-[var(--line)] py-3">
          <a class="font-medium hover:text-[var(--accent)]" href={`${B}roles/${rid}`}>{roleZh[rid] ?? rid}</a>
          <span class="num">{k(r.median_mid)}<span class="muted text-[12px] ml-2">n={r.n}</span></span>
        </div>
      ))}
    </div>
    <p class="muted text-[12.5px] mt-4">中文市场薪资见<a class="accent" href={B + "zh-market"}>中文市场页</a>；完整口径见<a class="accent" href={B + "salary"}>薪资页</a>。</p>
  </section>

  <!-- 高频技能 -->
  <section class="sec">
    <h2>高频技能 Top 15</h2>
    <p class="note">全部 {skills.skills.length} 项见<a class="accent" href={B + "skills"}>技能图谱</a>。</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
      {skills.skills.slice(0, 15).map((s) => (
        <div class="flex justify-between border-b border-[var(--line)] py-2 text-[13.5px]">
          <span>{s.name_zh}</span>
          <span class="num muted">
            {s.freq_pct}%
            {s.delta_pct != null
              ? <span class={`ml-3 ${s.delta_pct > 5 ? "up" : s.delta_pct < -5 ? "down" : ""}`}>{s.delta_pct > 0 ? "+" : ""}{s.delta_pct}%</span>
              : <span class="ml-3 missing">溢价样本不足</span>}
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- 入口 -->
  <section class="sec grid sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-2">
    {[
      ["岗位画像 ×6", "每个岗位：技能要求、薪资、远程比例、公司、岗位重合度。", "roles/llm-app"],
      ["中文市场", "腾讯、百度官网与 BOSS 授权切片的结构与薪资。", "zh-market"],
      ["路线生成器", "选背景与目标岗位，输出 8 周计划、作品集与面试题。", "radar"],
      ["公司热度", "哪些公司在持续招 AI 岗，按帖次数与方向拆分。", "companies"],
    ].map(([t, d, href]) => (
      <a class="block border-t-2 border-[var(--ink)] pt-3 pb-4 hover:border-[var(--accent)] group" href={B + href}>
        <div class="font-bold group-hover:text-[var(--accent)]">{t}</div>
        <p class="muted text-[13px] mt-1 leading-relaxed">{d}</p>
      </a>
    ))}
  </section>
</Base>

<script src={B + "echarts.min.js"} defer></script>
<script define:vars={{ roleData, trend }}>
  window.addEventListener("DOMContentLoaded", () => {
    if (!window.echarts) return;
    const css = getComputedStyle(document.documentElement);
    const C = {
      ink: css.getPropertyValue("--ink").trim() || "#211f1c",
      muted: css.getPropertyValue("--muted").trim() || "#716e66",
      line: css.getPropertyValue("--line").trim() || "#dddad2",
      accent: css.getPropertyValue("--accent").trim() || "#b03a26",
    };
    const base = { textStyle: { color: C.muted } };

    const r1 = echarts.init(document.getElementById("chart-roles"));
    r1.setOption({ ...base,
      grid: { left: 8, right: 40, top: 4, bottom: 4, containLabel: true },
      xAxis: { type: "value", splitLine: { show: false }, axisLabel: { color: C.muted, fontSize: 10 } },
      yAxis: { type: "category", data: roleData.map((r) => r.name_zh).reverse(), axisLine: { show: false }, axisTick: { show: false }, axisLabel: { color: C.ink, fontSize: 11.5 } },
      tooltip: {},
      series: [{ type: "bar", data: roleData.map((r) => r.n).reverse(), itemStyle: { color: C.ink }, barMaxWidth: 10,
        label: { show: true, position: "right", color: C.muted, fontSize: 10, fontFamily: "IBM Plex Mono, Menlo, monospace" } }],
    });

    const r2 = echarts.init(document.getElementById("chart-trend"));
    r2.setOption({ ...base,
      grid: { left: 8, right: 8, top: 30, bottom: 4, containLabel: true },
      legend: { data: ["全量帖子", "AI 相关"], textStyle: { color: C.muted, fontSize: 11 }, top: 0, icon: "rect", itemWidth: 10, itemHeight: 3 },
      xAxis: { type: "category", data: trend.map((t) => t.month.slice(2)), axisLine: { lineStyle: { color: C.line } }, axisTick: { show: false }, axisLabel: { color: C.muted, fontSize: 10 } },
      yAxis: { type: "value", splitLine: { lineStyle: { color: C.line } }, axisLabel: { color: C.muted, fontSize: 10 } },
      tooltip: { trigger: "axis" },
      series: [
        { name: "全量帖子", type: "line", smooth: false, symbol: "none", data: trend.map((t) => t.posts), lineStyle: { color: C.muted, width: 1.5 } },
        { name: "AI 相关", type: "line", smooth: false, symbol: "none", data: trend.map((t) => t.ai_posts), lineStyle: { color: C.accent, width: 2 }, areaStyle: { color: C.accent, opacity: 0.06 } },
      ],
    });

    const resize = () => { r1.resize(); r2.resize(); };
    window.addEventListener("resize", resize);
  });
</script>
