---
import Base from "../layouts/Base.astro";
import salary from "../data/salary.json";
import overview from "../data/overview.json";

const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const zh = (rid: string) =>
  overview.role_distribution.find((x) => x.role === rid)?.name_zh ??
  ({ "ml-research": "ML 研究", other: "通用 AI / 其他" })[rid] ?? rid;

function k(v) {
  return v == null ? "无" : "$" + Math.round(v / 1000) + "k";
}
function row(r) {
  return r.median_mid != null
    ? `${k(r.median_mid)}（P25–P75：${k(r.p25_mid)}–${k(r.p75_mid)}）`
    : "样本不足，无法给出";
}
const roleRows = Object.entries(salary.by_role).sort((a, b) => (b[1].median_mid ?? 0) - (a[1].median_mid ?? 0));
const cityRows = Object.entries(salary.by_city).sort((a, b) => (b[1].median_mid ?? 0) - (a[1].median_mid ?? 0));
const skillRows = salary.by_skill_top;
const remoteNames = { remote: "远程/可远程", hybrid: "混合", unknown: "未注明/驻场" };
---
<Base>
  <section class="pt-12 pb-4 md:pt-16">
    <h1 class="text-[32px] md:text-[44px] font-extrabold leading-tight tracking-tight">薪资</h1>
    <p class="muted mt-4 max-w-[70ch] text-[14.5px] leading-relaxed">
      全部数字来自岗位帖自述薪资区间的解析（区间中值口径），共 {salary.pool_size} 帖、
      占英文 AI 岗位 {salary.pool_share}%。未披露薪资的帖子不插补、不推算；样本 &lt; 8 的维度一律标注「样本不足」。
    </p>
    <p class="muted text-[12.5px] mt-3 max-w-[75ch]">
      口径：非美元按静态汇率粗略折算；股票期权不计入；时薪按 1750 小时/年折算；中文市场裸 K/万 按月薪口径年化。
      自述薪资存在选择性披露，读数当「区间感」而非精确行情。中文市场见<a class="accent" href={B + "zh-market"}>中文市场页</a>。
    </p>
  </section>

  <section class="sec">
    <h2>按岗位</h2>
    <div class="overflow-x-auto">
      <table class="data">
        <thead><tr><th>岗位</th><th class="num">帖数</th><th class="num">薪资样本</th><th class="num">覆盖率</th><th class="num">年薪读数（USD）</th></tr></thead>
        <tbody>
          {roleRows.map(([rid, r]) => (
            <tr>
              <td>{zh(rid)}</td>
              <td class="num">{r.n_posts}</td>
              <td class="num">{r.n || <span class="missing">0</span>}</td>
              <td class="num">{r.salary_available_share}%</td>
              <td class="num">{r.median_mid != null ? row(r) : <span class="missing">样本不足，无法给出</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="sec grid md:grid-cols-2 gap-x-12 gap-y-10">
    <div>
      <h2>按技能（溢价）</h2>
      <div class="overflow-x-auto">
        <table class="data">
          <thead><tr><th>技能</th><th class="num">溢价</th><th class="num">样本</th><th class="num">含技能中位</th><th class="num">不含中位</th></tr></thead>
          <tbody>
            {skillRows.map((s) => (
              <tr>
                <td>{s.skill}</td>
                <td class="num"><span class={s.delta_pct > 5 ? "up" : s.delta_pct < -5 ? "down" : ""}>{s.delta_pct > 0 ? "+" : ""}{s.delta_pct}%</span></td>
                <td class="num">{s.n_with}</td>
                <td class="num">{k(s.median_with)}</td>
                <td class="num">{k(s.median_without)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted text-[12px] mt-2">相关不等于因果：高溢价技能的从业者也常在大厂与高成本城市。</p>
    </div>
    <div>
      <h2>按城市</h2>
      <div class="overflow-x-auto">
        <table class="data">
          <thead><tr><th>城市</th><th class="num">帖数</th><th class="num">读数</th></tr></thead>
          <tbody>
            {cityRows.map(([city, r]) => (
              <tr><td>{city}</td><td class="num">{r.n_posts}</td>
                <td class="num">{r.median_mid != null ? row(r) : <span class="missing">样本不足</span>}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <h2 class="text-[17px] font-bold mt-10 mb-2">按办公形态</h2>
      <table class="data">
        <tbody>
          {Object.entries(salary.by_remote).map(([kind, r]) => (
            <tr><td>{remoteNames[kind]}</td><td class="num">{r.n_posts} 帖</td>
              <td class="num">{r.median_mid != null ? row(r) : <span class="missing">样本不足</span>}</td></tr>
          ))}
        </tbody>
      </table>
      <h2 class="text-[17px] font-bold mt-10 mb-2">按公司类型</h2>
      <table class="data">
        <tbody>
          {Object.entries(salary.by_stage).map(([stage, r]) => (
            <tr><td>{stage === "bigtech" ? "知名大厂 / AI 实验室（名单匹配）" : "自述融资阶段（seed / series）"}</td>
              <td class="num">{r.n_posts} 帖</td>
              <td class="num">{r.median_mid != null ? row(r) : <span class="missing">样本不足</span>}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
