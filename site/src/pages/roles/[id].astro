---
import Base from "../../layouts/Base.astro";
import roadmaps from "../../data/roadmaps.json";

export function getStaticPaths() {
  const ids = ["llm-app", "agent", "rag", "mlops", "ai-pm", "data-eng"];
  return ids.map((id) => ({ params: { id } }));
}
const { id } = Astro.params;
const p = await import(`../../data/profile_${id}.json`);
const profile = p.default;
const intro = roadmaps.intros[id] ?? "";
const route = roadmaps.routes[id];
const B = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const allIds = ["llm-app", "agent", "rag", "mlops", "ai-pm", "data-eng"];
const names = Object.fromEntries(allIds.map((x) => [x, roadmaps.routes[x] ? x : x]));
const zhName = (x: string) =>
  ({ "llm-app": "LLM 应用", "agent": "Agent", "rag": "RAG", "mlops": "Infra/MLOps", "ai-pm": "AI 产品", "data-eng": "数据工程" })[x] ?? x;

function k(v: number | null) {
  return v == null ? "—" : "$" + Math.round(v / 1000) + "k";
}
const sal = profile.salary;
---
<Base>
  <p class="muted text-sm mb-2"><a class="accent" href={B}>总览</a> / 岗位画像</p>
  <section class="mb-8">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-3xl font-extrabold">{profile.name_zh}</h1>
      <span class="muted text-sm">{profile.name_en}</span>
    </div>
    <p class="mt-3 max-w-3xl leading-relaxed">{intro}</p>
    <div class="flex flex-wrap gap-3 mt-4 text-sm">
      <span class="badge">样本 {profile.n_posts} 帖（多标签口径）</span>
      <span class="badge">占 AI 岗位 {profile.share_of_ai}%</span>
      <span class="badge">远程提及 {profile.remote_ratio}%</span>
    </div>
  </section>

  <section class="grid md:grid-cols-5 gap-6 mb-8">
    <div class="card p-5 md:col-span-3">
      <h2 class="font-bold mb-3">要求什么技能（按出现频率）</h2>
      {profile.top_skills.slice(0, 15).map((s) => (
        <div class="flex items-center gap-3 py-1.5 border-b border-white/5 text-sm">
          <span class="w-36 md:w-44 shrink-0 truncate">{s.name_zh}</span>
          <div class="flex-1 h-2 rounded bg-white/5 overflow-hidden">
            <div class="h-full rounded" style={`width:${Math.min(100, s.freq_pct * 2)}%;background:var(--accent)`}></div>
          </div>
          <span class="num muted w-12 text-right">{s.freq_pct}%</span>
        </div>
      ))}
    </div>
    <div class="card p-5 md:col-span-2">
      <h2 class="font-bold mb-3">薪资区间（USD 年薪）</h2>
      {sal.median_mid ? (
        <div>
          <div class="text-3xl font-extrabold num">{k(sal.median_mid)}</div>
          <div class="muted text-sm mt-1">中位（区间中值口径）</div>
          <div class="mt-4 space-y-1 text-sm num">
            <div class="flex justify-between"><span class="muted">P25–P75</span><span>{k(sal.p25_mid)} – {k(sal.p75_mid)}</span></div>
            <div class="flex justify-between"><span class="muted">区间下限中位</span><span>{k(sal.median_min)}</span></div>
            <div class="flex justify-between"><span class="muted">区间上限中位</span><span>{k(sal.median_max)}</span></div>
          </div>
        </div>
      ) : (
        <div class="missing">样本 &lt; 8，无法给出可靠中位数 —— 不编造</div>
      )}
      <div class="muted text-xs mt-4 space-y-1">
        <div>有薪资样本：{sal.n} 帖（覆盖率 {sal.salary_available_share}%）</div>
        <div>其余帖子未披露可解析薪资，本站不插补。</div>
      </div>
    </div>
  </section>

  <section class="grid md:grid-cols-2 gap-6 mb-8">
    <div class="card p-5">
      <h2 class="font-bold mb-3">城市分布（帖内提及）</h2>
      {profile.cities.length ? (
        <div class="flex flex-wrap gap-2">
          {profile.cities.map(([c, n]) => <span class="badge">{c} <span class="muted">{n}</span></span>)}
        </div>
      ) : <p class="muted text-sm">样本中未解析到城市（多为远程/未注明）。</p>}
      <h2 class="font-bold mt-6 mb-3">招聘公司 Top（帖次数）</h2>
      {profile.top_companies.length ? (
        <div class="flex flex-wrap gap-2">
          {profile.top_companies.map((c) => <span class="badge">{c.company} <span class="muted">{c.n}</span></span>)}
        </div>
      ) : <p class="muted text-sm">样本量小，无 ≥2 帖的公司。</p>}
    </div>
    <div class="card p-5">
      <h2 class="font-bold mb-3">真实岗位标题样本</h2>
      <ul class="space-y-2 text-sm">
        {profile.sample_titles.map((t) => (
          <li class="border-l-2 border-white/10 pl-3">
            <div>{t.title}</div>
            <div class="muted text-xs">{t.company || "（未注明公司）"} · {t.source}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="grid md:grid-cols-2 gap-6 mb-8">
    <div class="card p-5">
      <h2 class="font-bold mb-3">与相邻岗位的技能重合度（Jaccard）</h2>
      {Object.entries(profile.overlap).sort((a, b) => b[1] - a[1]).map(([other, v]) => (
        <div class="flex items-center gap-3 py-1.5 text-sm border-b border-white/5">
          <a class="accent w-28 shrink-0" href={`${B}roles/${other}`}>{zhName(other)}</a>
          <div class="flex-1 h-2 rounded bg-white/5 overflow-hidden">
            <div class="h-full rounded bg-[var(--accent2)]" style={`width:${v * 100}%`}></div>
          </div>
          <span class="num muted w-10 text-right">{Math.round(v * 100)}%</span>
        </div>
      ))}
      <p class="muted text-xs mt-3">重合度高 = 转型成本低：可优先考虑相邻岗位作为跳板。</p>
    </div>
    <div class="card p-5">
      <h2 class="font-bold mb-3">转型路线速览（8 周）</h2>
      <ol class="space-y-1.5 text-sm">
        {route.weeks.map((w) => (
          <li><span class="num muted mr-2">W{w.week}</span>{w.theme}</li>
        ))}
      </ol>
      <a class="inline-block mt-4 px-4 py-2 rounded-lg bg-[var(--accent)] text-[#06122e] font-semibold text-sm" href={`${B}radar?role=${id}`}>为我校定完整路线 →</a>
    </div>
  </section>
</Base>
